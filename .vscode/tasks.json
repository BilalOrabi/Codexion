{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "42: cc build active file (WSL)",
            "command": "wsl",
            "args": [
                "cc",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-pthread",
                "${fileBasename}",
                "-o",
                "${fileBasenameNoExtension}.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles active file inside Ubuntu WSL with strict 42 flags (-Wall -Wextra -Werror -pthread)"
        },
        {
            "type": "shell",
            "label": "42: run active file (WSL)",
            "command": "wsl",
            "args": [
                "./${fileBasenameNoExtension}.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Runs the compiled executable inside Ubuntu WSL"
        }
    ]
}